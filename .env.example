# --- Postgres ---
POSTGRES_USER=travelcompare
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=travelcompare
DATABASE_URL=postgresql://travelcompare:change_me_in_production@localhost:5432/travelcompare

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Auth secrets (generate real random values in production, e.g. `openssl rand -hex 64`) ---
JWT_ACCESS_SECRET=replace_with_a_long_random_string_access
JWT_REFRESH_SECRET=replace_with_a_long_random_string_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Rate limiting ---
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
